# Slyng Environment Configuration

# Application
NODE_ENV=development
PORT=5174
# PUBLIC_URL: this instance's external URL.
# Used as platform_origin and callback_url when redirecting to syr.
# For LAN dev, use your machine's IP: http://192.168.1.10:5174
PUBLIC_URL=http://localhost:5174

# SurrealDB Configuration
# Note: slyng uses port 8100 to avoid conflict with syr's SurrealDB on 8000
SURREALDB_URL=ws://localhost:8100/rpc
SURREALDB_NAMESPACE=slyng
SURREALDB_DATABASE=slyng
SURREALDB_USER=root
SURREALDB_PASS=slyng-dev-password

# NestJS API
SLYNG_API_PORT=5175
SLYNG_API_URL=http://localhost:5175

# Default Syr Instance (used as fallback when user doesn't specify)
SYR_INSTANCE_URL=http://localhost:5173

# ── Local identity provider (slyng acting as a syr instance) ─────────
# Both secrets must be ≥32 chars, distinct from each other, and stable
# across restarts. Generate with: openssl rand -hex 32
#
# SLYNG_JWT_SECRET signs session/platform access tokens (HS256).
# Falls back to SLYNG_SESSION_SECRET, then a process-lifetime random in
# dev; production fails closed without one.
SLYNG_JWT_SECRET=dev-only-slyng-jwt-secret-change-me-0000
# PLATFORM_DELEGATE_SECRET encrypts platform delegate private keys at
# rest (Aegis). Losing or changing it invalidates every delegation —
# treat like a KMS key. Local identity features fail closed without it.
PLATFORM_DELEGATE_SECRET=dev-only-delegate-secret-change-me-0000
# Local signup policy: open | invite_only | closed
# (kv instance_config/registration_mode overrides this when set)
SLYNG_REGISTRATION_MODE=open
# Platform delegation lifetimes (seconds). Defaults match syr.
# PLATFORM_REGISTRATION_EXPIRES_IN=600
# PLATFORM_TOKEN_EXPIRES_IN=86400
# Independent-login (self-custody / Syner, P10) callback-token lifetime — the
# window the browser has to poll after the device signs. Optional; default 300.
# INDEPENDENT_LOGIN_CALLBACK_TTL=300
# Instance upload limits (defaults; instance admins can override at runtime via
# Settings → Instance, stored in the kv instance_config table).
#   - Per-file cap (MB) enforced on EVERY upload path platform-wide
#     (chat attachments, library, stories, posts, profile images).
#   - Per-account file-library storage quota (GB).
# SLYNG_MAX_FILE_SIZE_MB=100
# SLYNG_STORAGE_LIMIT_GB=5
# Comma-separated LOCAL usernames granted instance-admin (can edit the limits
# above). The bootstrap so the operator can grant themselves admin without a DB
# edit. Matched case-sensitively against local accounts only — register the
# account first, and only local users (never same-named users from other
# instances) can ever match.
# SLYNG_ADMIN_USERNAMES=

# SeaweedFS / S3 (message attachments)
S3_ENDPOINT=http://localhost:8343
S3_BUCKET=slyng
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=slyng-access-key
S3_SECRET_ACCESS_KEY=slyng-secret-key
# Base URL used to build public attachment URLs. Typically S3_ENDPOINT + /<bucket>.
S3_PUBLIC_URL=http://localhost:8343/slyng
# Max bytes per uploaded file (500 MB)
UPLOAD_MAX_BYTES=524288000

# LiveKit — WebRTC SFU for voice/video
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://localhost:7880
# Set to your LAN IP for cross-device testing (e.g. 192.168.1.10)
LIVEKIT_NODE_IP=0.0.0.0

# Federated media proxy (IP-leak mitigation)
# 100 MB cap; anything larger triggers the "load directly from remote" UX
PROXY_MAX_BYTES=104857600
PROXY_TIMEOUT_MS=10000
# Allow proxying to RFC1918 / CGNAT addresses. Defaults to TRUE in
# development (NODE_ENV != production) so the same-box syr ↔ slyng LAN setup
# works. Set explicitly to `false` to harden even in dev. Loopback and
# link-local are always blocked regardless.
# PROXY_ALLOW_PRIVATE_IPS=false

# Klipy — GIF / sticker / clip / meme picker for the post editor (optional)
# KLIPY_WEB is Klipy's "web" platform key. It is a URL PATH SEGMENT (not a
# header), so it is strictly server-only. Unset → the picker reports
# unavailable and the editor's media tab shows a teach panel.
# KLIPY_WEB=
# KLIPY_API_BASE=https://api.klipy.com/api/v1
# Random salt so a user's derived Klipy customer/ad id can't be precomputed.
# KLIPY_CUSTOMER_SALT=
# Comma-separated allowlist of Klipy CDN hosts for saved clip URLs.
# KLIPY_MEDIA_HOSTS=static.klipy.com
